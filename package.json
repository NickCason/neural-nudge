{
  "name": "neural-nudge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Learn how neural networks work by being the optimizer first.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8097",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8097",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "e2e": "node scripts/play.mjs",
    "shots": "node scripts/shots.mjs",
    "icons": "node scripts/icons.mjs",
    "deploy": "bash scripts/deploy.sh",
    "gallery": "node scripts/gallery.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/recursive": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "playwright": "^1.62.1",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
